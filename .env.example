# Copia in .env.local (ignorato da git) e compila. Valori veri solo lì e su Vercel.
# Solo la chiave publishable (sb_publishable_...): mai la secret key (sb_secret_...) né la service_role.
# Solo l'indirizzo base del progetto, es. https://<progetto>.supabase.co (senza /rest/v1)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Facoltativo: contatto mostrato nella pagina /privacy (es. un indirizzo email). Solo su Vercel, mai nel repo.
VITE_PRIVACY_CONTACT=
# Facoltativo: chiave VAPID PUBBLICA per le notifiche (87 caratteri). La privata NON va qui: solo nei segreti di Supabase.
VITE_VAPID_PUBLIC_KEY=
